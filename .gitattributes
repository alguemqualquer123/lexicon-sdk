# Os launchers `bin/lex-*` sao scripts /bin/sh sem extensao: CRLF no checkout
# de Windows quebra o shebang quando o kit e usado em Linux/macOS.
bin/*          text eol=lf
*.sh           text eol=lf
*.lex          text eol=lf
*.md           text eol=lf
*.toml         text eol=lf
*.txt          text eol=lf
*.cmd          text eol=crlf
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.exe          binary
*.zip          binary
*.vsix         binary
